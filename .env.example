# ===========================================================================
# Copy this file to `.env` and edit. Only the BirdNET-Go location is required.
#   cp .env.example .env
# ===========================================================================

# --- Pre-built images (published to GHCR by GitHub Actions) ----------------
# Registry path for the three images. <owner> = your GitHub username/org,
# lowercased. The compose appends -adapter / -installer / -web.
IMAGE_BASE=ghcr.io/<owner>/avian-visitors-birdnet-go
IMAGE_TAG=latest

# --- Where is your BirdNET-Go instance? ------------------------------------
# Option A (simplest): full base URL, including port.
#   Use this if BirdNET-Go is on another host, or behind https/a reverse proxy.
BIRDNETGO_URL=http://192.168.1.50:8080
#
# Option B: host + port (used only when BIRDNETGO_URL is empty).
# BIRDNETGO_SCHEME=http
# BIRDNETGO_HOST=192.168.1.50
# BIRDNETGO_PORT=8080
#
# NOTE: this URL must be reachable FROM the adapter container. If BirdNET-Go
# runs in Docker on the same host, either publish its port and use the host IP,
# or attach this stack to BirdNET-Go's Docker network and use its service name
# (e.g. http://birdnet-go:8080). See README "Networking".

# Optional: bearer token if your BirdNET-Go API requires authentication.
# BIRDNETGO_API_TOKEN=

# --- Storage location ------------------------------------------------------
# A host directory where ALL data lives (frontend, illustrations, generated
# collage tables, and any Gemini-generated art). Bind-mounted into the stack,
# so it persists across `docker compose down` and rebuilds, and your NAS can
# back it up like any folder. It holds NO bird data (detections stay in
# BirdNET-Go), so it's safe to back up or delete.
#   - relative path (default): ./data next to docker-compose.yml
#   - absolute path on your NAS, e.g. /volume1/docker/avian-visitors
# The directory is created automatically if missing.
DATA_DIR=./data

# --- Web UI ----------------------------------------------------------------
# Port on the host where the collage is served: http://localhost:8090
WEB_PORT=8090

# Internal-only port the adapter listens on and nginx proxies to, over the
# private Docker network. NOT published to the host, so you rarely need to
# change it — only if it clashes on a custom/shared Docker network. Both the
# adapter and web services read this single value.
ADAPTER_PORT=9000

# Timezone for correct "today"/day-boundary maths (IANA name).
TZ=Europe/London

# --- Illustration packs ----------------------------------------------------
# Space-separated git repos of bird illustrations named <slug>.png (perched)
# and optional <slug>-2.png (flight), e.g. "Turdus migratorius" ->
# turdus-migratorius.png. Add as many as you like; later packs overlay earlier.
PACKS=https://github.com/lloydalexporter/AvianAssets_GB-ENG.git

# Also install AvianVisitors' bundled ~333-species base pack (mostly N. America).
# Leave false if a regional pack above already covers your birds.
INCLUDE_BASE_PACK=false

# Pin the AvianVisitors source (frontend + collage-table tool).
AV_REPO=https://github.com/Twarner491/AvianVisitors.git
AV_REF=avian-visitors
# Set true to re-pull the frontend on the next installer run (e.g. AV upgrade).
FORCE_FRONTEND=false
# After the first install the installer skips the pack download + mask rebuild
# so `docker compose up` stays fast. Set true (for one run) after changing PACKS
# to re-download and rebuild, e.g.:  FORCE_PACKS=true docker compose up -d
FORCE_PACKS=false

# --- Adapter tuning --------------------------------------------------------
# INFO for normal use; DEBUG logs every upstream call, cache hit, and timing.
LOG_LEVEL=INFO
# Upstream HTTP timeout (seconds).
HTTP_TIMEOUT=10
# Seconds to cache upstream responses (mirrors AV's max-age=30).
CACHE_TTL=30
# Safety cap on rows pulled for windowed/aggregate views. Raise for very busy
# stations or long history in the stats charts.
MAX_DETECTIONS=5000
# How many days back the stats calendar scans.
CALENDAR_MAX_DAYS=365

# --- Species "About" text (detail modal) -----------------------------------
# The adapter proxies Wikipedia for the description shown in a bird's detail
# modal. Set the language edition, or disable the lookup entirely.
WIKI_LANG=en
WIKI_ENABLED=true

# --- On-demand illustration generation (optional) --------------------------
# For a species with NO installed illustration, the detail modal's "generate
# image" button can render one via Google Gemini (perched + flight, instant
# chroma cutout), then rebuild the collage tables. OFF by default. To enable:
#   1) set GENERATE_ENABLED=true and provide a key (billing required):
#      https://aistudio.google.com/apikey
#   2) redeploy so the installer stages the generation scripts.
# Rarely needed if your PACKS already cover your region.
GENERATE_ENABLED=false
GEMINI_API_KEY=
# Max generations per rolling hour (cost brake).
GENERATE_HOURLY_CAP=6
